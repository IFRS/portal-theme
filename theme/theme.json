{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "templateParts": [
    {
      "area": "uncategorized",
      "name": "header-content",
      "title": "Conteúdo do Cabeçalho"
    },
    {
      "area": "uncategorized",
      "name": "noticias",
      "title": "Lista de Notícias"
    },
    {
      "area": "uncategorized",
      "name": "social",
      "title": "Redes Sociais"
    },
    {
      "area": "uncategorized",
      "name": "footer-content",
      "title": "Conteúdo do Rodapé"
    }
  ],
  "settings": {
    "blocks": {
      "core/image": {
        "lightbox": {
          "enabled": true,
          "allowEditing": true
        }
      }
    },
    "background":  {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
    "color": {
      "background": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "gradients": [
        {
          "gradient": "linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.9) 70%, rgba(0, 0, 0, 0.95) 90%, rgba(0, 0, 0, 1) 100%)",
          "name": "Gradiente Escuro Vertical",
          "slug": "dark-vertical"
        },
        {
          "gradient": "linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.9) 70%, rgba(0, 0, 0, 0.95) 90%, rgba(0, 0, 0, 1) 100%)",
          "name": "Gradiente Escuro Horizontal",
          "slug": "dark-horizontal"
        },
        {
          "gradient": "linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 70%, rgba(255, 255, 255, 0.95) 90%, rgba(255, 255, 255, 1) 100%)",
          "name": "Gradiente Claro Vertical",
          "slug": "light-vertical"
        },
        {
          "gradient": "linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 70%, rgba(255, 255, 255, 0.95) 90%, rgba(255, 255, 255, 1) 100%)",
          "name": "Gradiente Claro Horizontal",
          "slug": "light-horizontal"
        }
      ],
      "link": false,
      "palette": [
        {
          "color": "var(--bs-primary)",
          "name": "Principal",
          "slug": "primary"
        },
        {
          "color": "var(--bs-secondary)",
          "name": "Secundário",
          "slug": "secondary"
        },
        {
          "color": "var(--bs-accent)",
          "name": "Destaque",
          "slug": "accent"
        },
        {
          "color": "var(--bs-gold)",
          "name": "Dourado",
          "slug": "gold"
        },
        {
          "color": "var(--bs-light)",
          "name": "Claro",
          "slug": "light"
        },
        {
          "color": "var(--bs-dark)",
          "name": "Escuro",
          "slug": "dark"
        },
        {
          "color": "var(--bs-white)",
          "name": "Branco",
          "slug": "white"
        },
        {
          "color": "var(--bs-black)",
          "name": "Preto",
          "slug": "black"
        }
      ],
      "text": false
    },
    "dimensions": {
			"minHeight": false
		},
    "layout": {
      "allowCustomContentAndWideSize": false,
      "allowEditing": true,
      "contentSize": "1296px",
      "wideSize": "2560px"
    },
    "lightbox": {
      "enabled": true,
      "allowEditing": true
    },
    "position": {
			"sticky": false
		},
    "shadow": {
      "defaultPresets": true,
      "presets": [
        {
          "name": "Normal",
          "slug": "normal",
          "shadow": "var(--bs-box-shadow)"
        },
        {
          "name": "Pequena",
          "slug": "small",
          "shadow": "var(--bs-box-shadow-sm)"
        },
        {
          "name": "Grande",
          "slug": "large",
          "shadow": "var(--bs-box-shadow-lg)"
        },
        {
          "name": "Interna",
          "slug": "inner",
          "shadow": "var(--bs-box-shadow-inset)"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": false,
      "lineHeight": false,
      "textColumns": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false,
      "fontFamilies": [],
      "fluid": false,
      "fontSizes": [],
      "defaultFontSizes": false,
      "textAlign": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/search": {
        "elements": {
          "button": {
            "spacing": {
              "padding": {
                "top": "calc(0.667em + 2px)",
                "bottom": "calc(0.667em + 2px)",
                "left": "calc(0.667em + 2px)",
                "right": "calc(0.667em + 2px)"
              }
            },
            "border": {
              "radius": "var(--bs-border-radius-pill, 9999px)"
            },
            "color": {
              "background": "transparent",
              "text": "var(--bs-primary-text-emphasis)"
            },
            ":hover": {
              "color": {
                "background": "var(--bs-primary-bg-subtle)",
                "text": "var(--bs-primary-text-emphasis)"
              }
            }
          },
          "textInput": {
            "color": {
              "background": "inherit"
            }
          }
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "color": {
              "background": "transparent",
              "text": "var(--bs-primary-text-emphasis)"
            },
            "border": {
              "color": "var(--bs-primary)"
            },
            ":hover": {
              "color": {
                "background": "var(--bs-primary)",
                "text": "var(--bs-white)"
              },
              "typography": {
                "textDecoration": "none"
              }
            }
          }
        },
        "color": {
          "background": "var(--bs-primary)",
          "text": "var(--bs-white)"
        },
        "typography": {
          "fontWeight": "500",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--bs-link-hover-color)",
            "text": "var(--bs-white)"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "core/post-template": {
        "spacing": {
          "blockGap": "2rem 1.5rem"
        },
        "elements": {
          "h2": {
            "typography": {
              "fontSize": "1.3rem"
            }
          },
          "h3": {
            "typography": {
              "fontSize": "1.2rem"
            }
          }
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "var(--bs-border-radius-sm, 0)"
        }
      },
      "core/post-terms": {
        "color": {
          "text": "var(--bs-gray-600)"
        },
        "spacing": {
          "margin": {
            "top": "0.5rem"
          }
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "600",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "inherit"
            },
            "typography": {
              "fontWeight": "600",
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "color": {
          "text": "var(--bs-dark)"
        },
        "spacing": {
          "margin": {
            "top": "0.5rem",
            "bottom": "1rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "color": {
              "text": "inherit"
            }
          }
        }
      },
      "core/post-excerpt": {
        "spacing": {
          "margin": {
            "top": "0.5rem"
          }
        }
      },
      "core/post-content": {
        "spacing": {
          "margin": {
            "top": "2rem",
            "bottom": "2rem"
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var(--bs-gray-600)"
        },
        "spacing": {
          "margin": {
            "top": "0.75rem"
          }
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "border": {
          "color": "var(--bs-gray-500)"
        }
      }
    },
    "elements": {
      "link": {
        "typography": {
          "fontWeight": "500",
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      }
    },
    "spacing": {
      "blockGap": "2rem"
    }
  }
}
