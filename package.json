{
  "name": "ifrs-portal-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build --watch",
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "analyze": "analyze",
    "lint:js": "eslint src --ext .js",
    "lint:css": "stylelint \"sass/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/raleway": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@govbr-ds/core": "^3.5.1",
    "autoprefixer": "^10.2.5",
    "bootstrap": "^5.3.3",
    "datatables.net": "^2.2.2",
    "datatables.net-bs5": "^2.2.2",
    "datatables.net-plugins": "^2.2.1",
    "datatables.net-responsive-bs5": "^3.0.8",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "luxon": "^3.7.2",
    "mark.js": "^8.11.1",
    "postcss": "^8.2.7",
    "sass-embedded": "^1.86.0",
    "stylelint": "^17.11.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.0.13",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
